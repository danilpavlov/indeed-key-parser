# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/
# --- Rust (server) ---
/server/target/
/server/**/*.db
/server/**/*.db-*

# --- Android / Gradle ---
.gradle/
build/
/android/local.properties
/android/.gradle/
/android/build/
/android/app/build/
*.apk
*.ap_
*.dex
local.properties

# IDE
.idea/
*.iml
.DS_Store

# Gradle wrapper jar must be committed despite *.jar above
!**/gradle/wrapper/gradle-wrapper.jar

# Release signing secrets — keep local, never commit
*.jks
*.keystore
keystore.properties

# Local design/process docs — not tracked in the repo
.superpowers/
docs/

# Local environment (secrets)
.env
