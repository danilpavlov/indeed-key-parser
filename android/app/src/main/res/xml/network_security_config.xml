<?xml version="1.0" encoding="utf-8"?>
<!-- The webhook is self-hosted and user-configured (any LAN IP or hostname), so
     the app cannot know it at build time. Cleartext HTTP is therefore permitted
     for all hosts, which lets an http:// LAN webhook work on any user's network
     without rebuilding. HTTPS webhooks still work and remain certificate-validated;
     prefer https:// when the server has a trusted certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
