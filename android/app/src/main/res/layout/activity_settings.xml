<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mode"
            android:paddingTop="8dp" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/modeDirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Direct (USB) — phone plugged into the server host" />

            <RadioButton
                android:id="@+id/modeRemote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remote — LAN device or VPS" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/directBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Port (must match `adb reverse tcp:PORT` on the host)"
                android:paddingTop="16dp" />

            <EditText
                android:id="@+id/directPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="8080"
                android:inputType="number"
                android:autofillHints="" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/remoteBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Webhook URL"
                android:paddingTop="16dp" />

            <EditText
                android:id="@+id/webhookUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://host:8080/webhook"
                android:inputType="textUri"
                android:autofillHints="" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Secret"
            android:paddingTop="16dp" />

        <EditText
            android:id="@+id/secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bearer secret"
            android:inputType="textPassword"
            android:autofillHints="" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save" />

        <Button
            android:id="@+id/enableAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enable accessibility" />

    </LinearLayout>
</ScrollView>
